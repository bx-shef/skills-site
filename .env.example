# Скопировать в .env рядом с docker-compose.prod.yml (umask 077 — файл только владельцу).

# Домен сайта. DNS A-запись — на сервер ДО make prod-up, иначе сертификат не выпустится.
DOMAIN=skills.bx-shef.by
# E-mail для Let's Encrypt или пусто.
LETSENCRYPT_EMAIL=

# Ключ AI Router Вайбкода для чата по сайту. Пусто — сайт работает, чат выключен (503).
# Только сюда, в файлы репозитория ключ не попадает.
BXSHEF_EVAL_KEY=
# Адрес и модель — по умолчанию BitrixGPT через AI Router.
BXSHEF_EVAL_URL=https://vibecode.bitrix24.tech/v1
BXSHEF_CHAT_MODEL=bitrix/bitrixgpt-5.6-agent
# context | mcp
ASSISTANT_MODE=context
