# Скопировать в .env рядом с docker-compose.prod.yml (umask 077 — файл только владельцу).

# Домен сайта. DNS A-запись — на сервер ДО make prod-up, иначе сертификат не выпустится.
DOMAIN=docs.example.org
# E-mail для Let's Encrypt или пусто.
LETSENCRYPT_EMAIL=

# Модель чата по сайту — одна на установку, любой OpenAI-совместимый API (README, «Модель чата»).
# Без ключа сайт работает, чат выключен (503). Ключ — только сюда, в файлы репозитория он не попадает.
#
# BitrixGPT через AI Router Вайбкода (по умолчанию):
BXSHEF_CHAT_URL=https://vibecode.bitrix24.tech/v1
BXSHEF_CHAT_KEY=
BXSHEF_CHAT_MODEL=bitrix/bitrixgpt-5.6-agent
# Как называть модель на сайте («Ответы … могут быть неточны»); пусто — по id модели.
BXSHEF_CHAT_MODEL_NAME=
#
# DeepSeek напрямую (id моделей — по документации DeepSeek на момент настройки):
# BXSHEF_CHAT_URL=https://api.deepseek.com/v1
# BXSHEF_CHAT_KEY=sk-…
# BXSHEF_CHAT_MODEL=deepseek-chat
# BXSHEF_CHAT_MODEL_NAME=DeepSeek

# Оценки ответов чата («полезно / не помогло») — в приёмник отзывов (skills-standard/feedback,
# категория RATING). Пусто — оценки остаются только в браузере пользователя.
BXSHEF_FEEDBACK_URL=
# Токен, если приёмник требует его на отправку (FEEDBACK_TOKEN приёмника).
BXSHEF_FEEDBACK_TOKEN=
